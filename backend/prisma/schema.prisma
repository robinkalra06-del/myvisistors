datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

enum ParticipantStatus {
  WAITING
  ADMITTED
  REJECTED
  LEFT
}

enum RecordingStatus {
  PROCESSING
  READY
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  password            String
  fullName            String
  avatarUrl           String?            @db.Text
  role                UserRole           @default(USER)
  status              UserStatus         @default(ACTIVE)
  isVerified          Boolean            @default(true)
  personalMeetingCode String             @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  meetings            Meeting[]          @relation("HostedMeetings")
  participations      MeetingParticipant[]
  recordings          Recording[]
  subscriptions       UserSubscription[]
  auditLogs           AuditLog[]
  supportTickets      SupportTicket[]
  organizationMembers OrganizationMember[]

  @@index([email])
  @@index([personalMeetingCode])
}

model Organization {
  id          String               @id @default(uuid())
  name        String
  slug        String               @unique
  ownerId     String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  members     OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER")
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

model Meeting {
  id                     String              @id @default(uuid())
  code                   String              @unique // format: abc-defg-hij
  title                  String
  description            String?             @db.Text
  hostId                 String
  scheduledAt            DateTime?
  durationMinutes        Int                 @default(60)
  passcode               String?
  isLocked               Boolean             @default(false)
  isWaitingRoom          Boolean             @default(false)
  isScreenShareRestricted Boolean            @default(false)
  isChatRestricted       Boolean             @default(false)
  status                 MeetingStatus       @default(SCHEDULED)
  startedAt              DateTime?
  endedAt                DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  host                   User                @relation("HostedMeetings", fields: [hostId], references: [id], onDelete: Cascade)
  participants           MeetingParticipant[]
  invitations            MeetingInvitation[]
  chatMessages           ChatMessage[]
  recordings             Recording[]

  @@index([code])
  @@index([hostId])
  @@index([status])
}

model MeetingParticipant {
  id           String            @id @default(uuid())
  meetingId    String
  userId       String?
  guestName    String
  guestEmail   String?
  role         ParticipantRole   @default(PARTICIPANT)
  status       ParticipantStatus @default(ADMITTED)
  isMuted      Boolean           @default(false)
  isVideoOff   Boolean           @default(false)
  isHandRaised Boolean           @default(false)
  joinedAt     DateTime          @default(now())
  leftAt       DateTime?

  meeting      Meeting           @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([meetingId])
  @@index([userId])
}

model MeetingInvitation {
  id        String   @id @default(uuid())
  meetingId String
  email     String
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt DateTime @default(now())

  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([email])
}

model ChatMessage {
  id          String   @id @default(uuid())
  meetingId   String
  senderId    String?
  senderName  String
  senderAvatar String? @db.Text
  content     String   @db.Text
  isPrivate   Boolean  @default(false)
  recipientId String?
  createdAt   DateTime @default(now())

  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([recipientId])
}

model Recording {
  id              String          @id @default(uuid())
  meetingId       String
  hostId          String
  title           String
  fileUrl         String          @db.Text
  storageKey      String?
  fileSize        BigInt          @default(0)
  durationSeconds Int             @default(0)
  status          RecordingStatus @default(READY)
  createdAt       DateTime        @default(now())

  meeting         Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  host            User            @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([hostId])
}

model SubscriptionPlan {
  id                 String             @id @default(uuid())
  name               String
  code               String             @unique // FREE, PRO, BUSINESS
  priceMonthly       Int                @default(0) // in USD cents e.g. 1200 = $12
  priceYearly        Int                @default(0)
  maxDurationMinutes Int                @default(45)
  maxParticipants    Int                @default(100)
  cloudRecording     Boolean            @default(false)
  maxStorageMB       Int                @default(500)
  featuresJson       String             @db.Text
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  subscriptions      UserSubscription[]
}

model UserSubscription {
  id                   String             @id @default(uuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([planId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?  @db.Text
  detailsJson  String?  @db.Text
  createdAt    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id        String         @id @default(uuid())
  userId    String?
  email     String
  subject   String
  message   String         @db.Text
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}
