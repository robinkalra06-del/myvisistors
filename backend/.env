JWT_REFRESH_EXPIRES_IN="7d"

# LiveKit SFU (Optional / Ready for Production LiveKit Server)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secretkeypulsemeet1234567890abcdef"
