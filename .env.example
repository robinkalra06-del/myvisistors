# ==============================================================================
# LiveTrack Environment Variables Configuration
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=10000
HOST=0.0.0.0

# Database Configuration (PostgreSQL in production, SQLite fallback in local development)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/livetrack?schema=public

# Optional Redis Instance (for Socket.IO horizontal scaling)
REDIS_URL=redis://localhost:6379

# Authentication & Security Secrets
JWT_SECRET=livetrack_super_secret_jwt_key_2026_change_in_production!
JWT_EXPIRES_IN=7d
SESSION_SECRET=livetrack_session_secret_2026_change_me!

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:10000
VITE_API_URL=http://localhost:10000

# CORS Allowed Origins (Comma-separated or *)
CORS_ORIGINS=*

# Optional MaxMind or IP Geolocation Key
GEOIP_API_KEY=

# Optional SMTP Email Dispatcher for Visitor Alerts
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=LiveTrack Alerts <alerts@livetrack.io>

# Rate Limiting
RATE_LIMIT_MAX=600
