# ===================================================
# PulseMeet Environment Configuration
# ===================================================

# Application
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173

# Database Connection (XAMPP MySQL or Docker MySQL)
DATABASE_URL="mysql://root:@127.0.0.1:3306/meet_db"

# JWT Authentication
JWT_ACCESS_SECRET="pulsemeet-access-secret-super-secure-key-2025"
JWT_REFRESH_SECRET="pulsemeet-refresh-secret-super-secure-key-2025"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# LiveKit SFU Server (Optional for multi-party group calls)
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secretkeypulsemeet1234567890abcdef"
LIVEKIT_URL="ws://localhost:7880"

# Stripe Payments (Optional for billing integration)
STRIPE_SECRET_KEY="sk_test_pulsemeet_mock_key"
STRIPE_WEBHOOK_SECRET="whsec_pulsemeet_mock_webhook"

# Storage
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=250
